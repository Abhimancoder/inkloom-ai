# ================================================================
# INKLOOM AI — BACKEND ENVIRONMENT VARIABLES TEMPLATE
# ================================================================
# DO NOT store real secrets in this file. Copy to .env and fill values.

PORT=5000
MONGODB_URI=mongodb://localhost:27017/inkloom
NODE_ENV=development

# --- Round 3 Webhook & Connector Credentials (Optional / Server-Side Only) ---
# If left blank, connectors automatically operate in verified Simulation Mode
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/PLACEHOLDER/TOKEN
HUBSPOT_ACCESS_TOKEN=pat-na1-placeholder-token
WORDPRESS_ENDPOINT=https://your-wordpress-site.com/wp-json
WORDPRESS_APP_PASSWORD=placeholder_app_password

# --- Inkloom Guide AI Assistant (Server-Side Only) ---
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
